# VGC Shelf Unraid example environment
# Copy this file to .env and update the values before starting.

POSTGRES_USER=vgc
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=vgcshelf

# The password here must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://vgc:replace-with-a-strong-password@db:5432/vgcshelf?schema=public

# Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Change to your Unraid server URL/IP.
CORS_ORIGIN=http://YOUR_UNRAID_IP:3000

FRONTEND_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
REDIS_URL=

# AppData paths
VGC_APPDATA=/mnt/user/appdata/vgc-shelf
